# Copy this file to .env and fill in your two keys.

# Google Map Tiles API key (Google Cloud console -> APIs & Services -> Credentials)
GOOGLE_TILES_API_KEY=paste-your-google-key-here

# Gemini API key (https://aistudio.google.com/apikey) - the free tier is enough
GEMINI_API_KEY=paste-your-gemini-key-here

# Free-tier image model. Change only if Google renames it.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Do not edit: passes the Google key to the renderer page
VITE_GOOGLE_TILES_API_KEY=${GOOGLE_TILES_API_KEY}
